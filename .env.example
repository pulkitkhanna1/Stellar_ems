# Optional: only needed when regenerating data/public-links.json via scripts/build_public_links.py
EMS_DRIVE_API_KEY=your_google_drive_api_key_here

# Required for cross-device progress sync backend (/api/progress)
PROGRESS_GIST_ID=your_github_gist_id
PROGRESS_GITHUB_TOKEN=your_github_token_with_gist_scope

# Optional extra protection for write requests
PROGRESS_WRITE_KEY=your_custom_write_key
